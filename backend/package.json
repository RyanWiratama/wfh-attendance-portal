  "scripts": {
    "build": "nest build backend && nest build auth-service && nest build employee-service && nest build attendance-service",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "concurrently -n \"GATEWAY,AUTH,EMPLOYEE,ATTENDANCE\" -c \"cyan,yellow,green,magenta\" \"nest start --watch backend\" \"nest start --watch auth-service\" \"nest start --watch employee-service\" \"nest start --watch attendance-service\"",
    "start:gateway": "nest start --watch backend",
    "start:auth": "nest start --watch auth-service",
    "start:employee": "nest start --watch employee-service",
    "start:attendance": "nest start --watch attendance-service",
    "start:prod": "node dist/apps/backend/main",
    "seed:demo": "ts-node -r tsconfig-paths/register seed.ts",
    "lint": "oxlint --type-aware apps/ libs/"
  },
  "dependencies": {
